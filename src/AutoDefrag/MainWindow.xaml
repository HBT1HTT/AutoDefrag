<Window x:Class="AutoDefrag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoDefrag"
        Width="560" Height="470" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 标题 ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="pack://application:,,,/Assets/icon-256.png"
                   Width="26" Height="26" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="AutoDefrag"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />

            <Button Grid.Column="2" Content="设置"
                    Style="{StaticResource LinkButton}"
                    FontSize="12" Foreground="{DynamicResource TextSecondary}"
                    Padding="6,4" Click="Settings_Click" />
        </Grid>

        <!-- ================= 磁盘列表 ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10"
                Margin="0,10,0,12">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 列标题 -->
                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="TypeCol" />
                        <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="SpaceCol" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="盘符" Style="{StaticResource HintText}" Margin="0" />
                    <TextBlock Grid.Column="2" Text="卷标" Style="{StaticResource HintText}" Margin="0" />
                    <TextBlock Grid.Column="3" Text="类型" Style="{StaticResource HintText}" Margin="0" />
                    <TextBlock Grid.Column="4" Text="空间" Style="{StaticResource HintText}"
                               Margin="0" HorizontalAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="2,6" Background="Transparent"
                                        ToolTip="{Binding ToolTip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="TypeCol" />
                                            <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="SpaceCol" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource FluentCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding Letter}"
                                                   VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />

                                        <TextBlock Grid.Column="2" Text="{Binding VolumeLabel}"
                                                   VerticalAlignment="Center" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" />

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AvailableText}" FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding TotalText}" FontSize="11"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextTertiary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="未检测到本地固定磁盘"
                           Style="{StaticResource HintText}"
                           Visibility="{Binding EmptyHintVisibility}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Text="{Binding LargeClusterHint}"
                           Style="{StaticResource HintText}" Margin="2,8,2,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding LargeClusterHintVisibility}" />
            </Grid>
        </Border>

        <!-- ================= 底部操作 ================= -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="查看日志" Style="{StaticResource SecondaryButton}"
                    Click="OpenLog_Click" />
            <Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}"
                    Click="Optimize_Click" Margin="8,0,0,0" MinWidth="104"
                    IsEnabled="{Binding CanStart}" />
        </StackPanel>
    </Grid>
</Window>
