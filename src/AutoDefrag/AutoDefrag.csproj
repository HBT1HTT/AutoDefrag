<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AutoDefrag</RootNamespace>
    <AssemblyName>AutoDefrag</AssemblyName>
    <ApplicationIcon>Assets\AutoDefrag.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.9.1</Version>
    <AssemblyVersion>1.9.1.0</AssemblyVersion>
    <FileVersion>1.9.1.0</FileVersion>
    <InformationalVersion>1.9.1</InformationalVersion>
    <Product>AutoDefrag</Product>
    <AssemblyTitle>AutoDefrag</AssemblyTitle>
    <Company>AutoDefrag</Company>
    <Copyright>AutoDefrag</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

    <!-- 发布形态: 自包含 + 单文件 (win-x64), 目标机无需安装 .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AutoDefrag.ico" />
    <Resource Include="Assets\icon-256.png" />
  </ItemGroup>

</Project>
