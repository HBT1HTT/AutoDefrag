<Application x:Class="AutoDefrag.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutoDefrag;component/Styles/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
            <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
